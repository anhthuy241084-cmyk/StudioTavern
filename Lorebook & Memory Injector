// ==UserScript==
// @name         Google AI Studio: Deep Roleplay Lorebook & Memory Injector
// @namespace    http://tampermonkey.net/
// @version      1.0.0
// @description  Hệ thống Lorebook/World Info chuyên nghiệp cho AI Studio. Tự động quét từ khóa và tiêm ngữ cảnh ngầm vào prompt.
// @author       You & AI Assistant
// @match        https://aistudio.google.com/*
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_notification
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    // ==========================================
    // 1. DATA MANAGEMENT & STORAGE
    // ==========================================
    const STORAGE_KEY = 'AISTUDIO_LOREBOOK_DATA';
    
    // Dữ liệu mẫu ban đầu nếu người dùng chưa tạo
    const defaultData = [
        {
            id: 'demo-1',
            enabled: true,
            keys: 'Arthur, Excalibur',
            content: '[Thông tin thế giới: Arthur là vua của Camelot, sở hữu thanh kiếm Excalibur có thể chém đứt mọi ma thuật hắc ám.]'
        }
    ];

    function getLoreData() {
        const data = localStorage.getItem(STORAGE_KEY);
        return data ? JSON.parse(data) : defaultData;
    }

    function saveLoreData(data) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    }

    // ==========================================
    // 2. NETWORK INTERCEPTOR (CORE ENGINE)
    // ==========================================
    // Hook thẳng vào Fetch API để can thiệp JSON trước khi gửi cho Google
    const originalFetch = window.fetch;
    window.fetch = async function (...args) {
        let [resource, config] = args;

        // Chỉ can thiệp vào các API gửi tin nhắn (generateContent)
        if (typeof resource === 'string' && resource.includes(':generateContent') && config && config.body) {
            try {
                let payload = JSON.parse(config.body);
                const loreList = getLoreData().filter(item => item.enabled);

                // Lấy nội dung tin nhắn mới nhất mà người dùng vừa nhập
                let contents = payload.contents || [];
                let lastUserMessage = contents[contents.length - 1];

                if (lastUserMessage && lastUserMessage.parts && lastUserMessage.parts.length > 0) {
                    let promptText = lastUserMessage.parts[0].text || '';
                    let injectedContext = [];

                    // Quét toàn bộ Lorebook
                    loreList.forEach(entry => {
                        const keywords = entry.keys.split(',').map(k => k.trim().toLowerCase());
                        const matched = keywords.some(key => {
                            if (!key) return false;
                            // Kiểm tra từ khóa có nằm trong văn bản không (không phân biệt hoa thường)
                            const regex = new RegExp(`\\b${key}\\b`, 'i');
                            return regex.test(promptText);
                        });

                        if (matched) {
                            injectedContext.push(entry.content);
                        }
                    });

                    // Nếu tìm thấy từ khóa, tiến hành "tiêm" ngữ cảnh vào tin nhắn bí mật
                    if (injectedContext.length > 0) {
                        const contextString = "\n\n=== [MEMORY INJECTION / THÔNG TIN KÍ ỨC ĐƯỢC KÍCH HOẠT] ===\n" + 
                                              injectedContext.join("\n") + 
                                              "\n=======================================================\n\n";

                        // Tiêm vào đầu tin nhắn của user ở tầng Payload API (Giao diện người dùng sẽ không nhìn thấy)
                        lastUserMessage.parts[0].text = contextString + promptText;
                        
                        console.log('%c[LoreMaster]%c Đã kích hoạt và tiêm các Lore sau:', 'color: #00ffaa; font-weight: bold;', 'color: white;', injectedContext);
                        showToast(`📖 Đã kích hoạt ${injectedContext.length} Lorebook ngầm!`);
                    }
                }

                // Đóng gói lại body đã can thiệp
                config.body = JSON.stringify(payload);
            } catch (err) {
                console.error('[LoreMaster] Lỗi khi can thiệp Payload:', err);
            }
        }

        return originalFetch.apply(this, [resource, config]);
    };

    // ==========================================
    // 3. UI INJECTION & STYLES
    // ==========================================
    const style = document.createElement('style');
    style.textContent = `
        #lore-fab {
            position: fixed;
            bottom: 25px;
            right: 25px;
            width: 50px;
            height: 50px;
            background: #1e1e2e;
            color: #cdd6f4;
            border: 2px solid #89b4fa;
            border-radius: 50%;
            cursor: pointer;
            z-index: 999999;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            font-size: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }
        #lore-fab:hover { transform: scale(1.1); background: #313244; }

        #lore-modal {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 550px;
            max-height: 80vh;
            background: #181825;
            color: #cdd6f4;
            border: 1px solid #45475a;
            border-radius: 12px;
            z-index: 1000000;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            flex-direction: column;
            overflow: hidden;
        }

        .lore-header {
            padding: 15px 20px;
            background: #11111b;
            border-bottom: 1px solid #313244;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: bold;
            font-size: 16px;
        }

        .lore-close { cursor: pointer; color: #f38ba8; font-size: 20px; }

        .lore-body {
            padding: 20px;
            overflow-y: auto;
            max-height: calc(80vh - 120px);
        }

        .lore-item {
            background: #1e1e2e;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 12px;
            border: 1px solid #313244;
            position: relative;
        }

        .lore-item input, .lore-item textarea {
            width: 95%;
            background: #313244;
            border: 1px solid #45475a;
            color: white;
            padding: 6px 10px;
            border-radius: 4px;
            margin-top: 5px;
            font-family: inherit;
        }

        .lore-item textarea { resize: vertical; height: 60px; }

        .lore-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 8px;
        }

        .lore-btn {
            background: #89b4fa;
            color: #11111b;
            border: none;
            padding: 6px 14px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .lore-btn:hover { opacity: 0.9; }

        .lore-btn-del {
            background: #f38ba8;
            color: #11111b;
        }

        .lore-footer {
            padding: 10px 20px;
            background: #11111b;
            border-top: 1px solid #313244;
            display: flex;
            gap: 10px;
        }

        #lore-toast {
            position: fixed;
            bottom: 85px;
            right: 25px;
            background: #a6e3a1;
            color: #11111b;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: bold;
            z-index: 1000000;
            display: none;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }
    `;
    document.head.appendChild(style);

    // Toast notification mini
    function showToast(text) {
        let toast = document.getElementById('lore-toast');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'lore-toast';
            document.body.appendChild(toast);
        }
        toast.textContent = text;
        toast.style.display = 'block';
        setTimeout(() => { toast.style.display = 'none'; }, 3000);
    }

    // ==========================================
    // 4. UI CREATION (DOM Ready)
    // ==========================================
    window.addEventListener('DOMContentLoaded', () => {
        // Nút mở Menu tròn
        const fab = document.createElement('div');
        fab.id = 'lore-fab';
        fab.innerHTML = '📖';
        fab.title = 'Mở Lorebook & Memory Injector';
        document.body.appendChild(fab);

        // Bảng điều khiển Modal
        const modal = document.createElement('div');
        modal.id = 'lore-modal';
        modal.innerHTML = `
            <div class="lore-header">
                <span>📚 Lorebook & Memory Hub</span>
                <span class="lore-close">&times;</span>
            </div>
            <div class="lore-body" id="lore-container">
                <!-- Danh sách lore sẽ render ở đây -->
            </div>
            <div class="lore-footer">
                <button class="lore-btn" id="lore-add-btn">+ Thêm Entry Mới</button>
                <button class="lore-btn" id="lore-export-btn" style="background:#f9e2af;">Xuất JSON</button>
            </div>
        `;
        document.body.appendChild(modal);

        // Events
        fab.addEventListener('click', () => {
            modal.style.display = (modal.style.display === 'flex') ? 'none' : 'flex';
            renderLoreItems();
        });

        modal.querySelector('.lore-close').addEventListener('click', () => {
            modal.style.display = 'none';
        });

        document.getElementById('lore-add-btn').addEventListener('click', () => {
            const data = getLoreData();
            data.push({
                id: 'lore-' + Date.now(),
                enabled: true,
                keys: 'Từ khóa (cách nhau bằng phẩy)',
                content: 'Nội dung bối cảnh cần tiêm vào trí nhớ AI...'
            });
            saveLoreData(data);
            renderLoreItems();
        });

        document.getElementById('lore-export-btn').addEventListener('click', () => {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(getLoreData(), null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", "ai_studio_lorebook.json");
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        });
    });

    function renderLoreItems() {
        const container = document.getElementById('lore-container');
        container.innerHTML = '';
        const data = getLoreData();

        data.forEach((item, index) => {
            const div = document.createElement('div');
            div.className = 'lore-item';
            div.innerHTML = `
                <div style="display:flex; justify-content:space-between;">
                    <label><input type="checkbox" class="lore-toggle" ${item.enabled ? 'checked' : ''}> Kích hoạt</label>
                </div>
                <div>
                    <label style="font-size:12px; color:#a6adc8;">Từ khóa kích hoạt (ngăn cách bằng dấu phẩy):</label>
                    <input type="text" class="lore-keys" value="${item.keys}">
                </div>
                <div style="margin-top: 5px;">
                    <label style="font-size:12px; color:#a6adc8;">Nội dung ngầm (Lore Prompt):</label>
                    <textarea class="lore-content">${item.content}</textarea>
                </div>
                <div class="lore-actions">
                    <button class="lore-btn lore-btn-del" data-index="${index}">Xóa</button>
                </div>
            `;

            // Lưu thay đổi khi gõ
            div.querySelector('.lore-toggle').addEventListener('change', (e) => {
                data[index].enabled = e.target.checked;
                saveLoreData(data);
            });
            div.querySelector('.lore-keys').addEventListener('change', (e) => {
                data[index].keys = e.target.value;
                saveLoreData(data);
            });
            div.querySelector('.lore-content').addEventListener('change', (e) => {
                data[index].content = e.target.value;
                saveLoreData(data);
            });

            div.querySelector('.lore-btn-del').addEventListener('click', () => {
                data.splice(index, 1);
                saveLoreData(data);
                renderLoreItems();
            });

            container.appendChild(div);
        });
    }

})();
