// ==UserScript==
// @name         Google AI Studio: SillyStudio Visual Tavern Overhaul
// @namespace    http://tampermonkey.net/
// @version      1.0.0
// @description  Biến AI Studio thành SillyTavern: Đổi Avatar, Tên, Khung chat đa phong cách, Font chữ tùy biến & Ảnh nền.
// @author       You & AI Assistant
// @match        https://aistudio.google.com/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    // ==========================================
    // 1. DATA STORAGE & GOOGLE DRIVE FIXER
    // ==========================================
    const STORAGE_KEY = 'SILLY_STUDIO_CONFIG';

    const defaultConfig = {
        userName: 'Nhà Thám Hiểm',
        userAvatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Adventurer',
        modelName: 'Nữ Thần / Elf Companion',
        modelAvatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Goddess',
        theme: 'theme-visualnovel', // visualnovel, fantasy, cyberpunk, gothic, terminal, softpaper
        fontFamily: 'Playfair Display', // Cinzel, Playfair Display, VT323, Dancing Script, Inter
        fontSize: '15',
        bgImage: '',
        bgOpacity: '0.15'
    };

    function getConfig() {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? { ...defaultConfig, ...JSON.parse(raw) } : defaultConfig;
    }

    function saveConfig(cfg) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(cfg));
        applyStylesAndThemes();
    }

    // Tự động chuyển link Google Drive dạng chia sẻ sang Direct Image Link
    function fixGoogleDriveUrl(url) {
        if (!url) return '';
        const match = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/) || url.match(/id=([a-zA-Z0-9_-]+)/);
        if (match && match[1]) {
            return `https://lh3.googleusercontent.com/d/${match[1]}`;
        }
        return url;
    }

    // ==========================================
    // 2. INJECT GOOGLE FONTS & STYLES
    // ==========================================
    const fontLink = document.createElement('link');
    fontLink.rel = 'stylesheet';
    fontLink.href = 'https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800&family=Dancing+Script:wght@600&family=Inter:wght@400;600&family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=VT323&display=swap';
    document.head.appendChild(fontLink);

    const mainStyle = document.createElement('style');
    mainStyle.id = 'silly-studio-core-styles';
    document.head.appendChild(mainStyle);

    function applyStylesAndThemes() {
        const cfg = getConfig();

        mainStyle.textContent = `
            /* Background Wallpaper */
            ${cfg.bgImage ? `
            body::before {
                content: '';
                position: fixed;
                top: 0; left: 0; right: 0; bottom: 0;
                background-image: url('${cfg.bgImage}');
                background-size: cover;
                background-position: center;
                opacity: ${cfg.bgOpacity};
                z-index: -1;
                pointer-events: none;
            }
            ` : ''}

            /* Custom Font & Global Text Styling */
            ms-chat-turn, .chat-turn, .chat-turn-content, .model-prompt-container, .user-prompt-container {
                font-family: '${cfg.fontFamily}', serif, sans-serif !important;
                font-size: ${cfg.fontSize}px !important;
                line-height: 1.6 !important;
            }

            /* ---------------- KHUNG THEME ---------------- */

            /* THEME 1: VISUAL NOVEL (Ren'Py / RPG Maker Style) */
            .theme-visualnovel ms-chat-turn, .theme-visualnovel .chat-turn {
                background: rgba(24, 24, 37, 0.85) !important;
                border: 2px solid #89b4fa !important;
                border-radius: 12px !important;
                margin-bottom: 20px !important;
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6) !important;
                backdrop-filter: blur(8px) !important;
                padding: 16px 20px !important;
            }

            /* THEME 2: FANTASY PARCHMENT (Giấy cuộn Trung Cổ) */
            .theme-fantasy ms-chat-turn, .theme-fantasy .chat-turn {
                background: #f4ecd8 !important;
                color: #2c1d11 !important;
                border: 3px double #8c6747 !important;
                border-radius: 4px !important;
                box-shadow: inset 0 0 30px rgba(160, 120, 80, 0.25), 0 5px 15px rgba(0,0,0,0.5) !important;
                margin-bottom: 20px !important;
                padding: 18px !important;
            }
            .theme-fantasy .silly-name-tag { color: #8b0000 !important; font-family: 'Cinzel', serif !important; font-weight: bold; }

            /* THEME 3: CYBERPUNK NEON */
            .theme-cyberpunk ms-chat-turn, .theme-cyberpunk .chat-turn {
                background: rgba(10, 10, 18, 0.9) !important;
                border-left: 5px solid #00ffcc !important;
                border-right: 2px solid #ff007f !important;
                border-top: 1px solid #1f2335 !important;
                border-bottom: 1px solid #1f2335 !important;
                clip-path: polygon(0 0, calc(100% - 15px) 0, 100% 15px, 100% 100%, 15px 100%, 0 calc(100% - 15px)) !important;
                margin-bottom: 22px !important;
                box-shadow: 0 0 20px rgba(0, 255, 204, 0.15) !important;
            }
            .theme-cyberpunk .silly-name-tag { color: #00ffcc !important; text-shadow: 0 0 8px #00ffcc; letter-spacing: 1px; }

            /* THEME 4: ROYAL GOTHIC (Hắc Ám Quý Tộc) */
            .theme-gothic ms-chat-turn, .theme-gothic .chat-turn {
                background: linear-gradient(135deg, #16161e 0%, #1a1b26 100%) !important;
                border: 1px solid #e0af68 !important;
                border-radius: 8px !important;
                box-shadow: 0 4px 20px rgba(224, 175, 104, 0.15) !important;
                margin-bottom: 20px !important;
            }
            .theme-gothic .silly-name-tag { color: #e0af68 !important; font-family: 'Cinzel', serif !important; }

            /* THEME 5: RETRO TERMINAL (Máy tính cổ) */
            .theme-terminal ms-chat-turn, .theme-terminal .chat-turn {
                background: #050d08 !important;
                color: #33ff66 !important;
                border: 1px solid #33ff66 !important;
                font-family: 'VT323', monospace !important;
                font-size: 18px !important;
                box-shadow: 0 0 15px rgba(51, 255, 102, 0.2) !important;
                margin-bottom: 15px !important;
            }
            .theme-terminal .silly-name-tag { color: #33ff66 !important; font-family: 'VT323', monospace !important; }

            /* ---------------- AVATAR & NAME TAGS ---------------- */
            .silly-avatar-img {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid currentColor;
                box-shadow: 0 3px 10px rgba(0,0,0,0.5);
                margin-right: 12px;
                flex-shrink: 0;
            }

            .silly-header-row {
                display: flex;
                align-items: center;
                margin-bottom: 10px;
                padding-bottom: 6px;
                border-bottom: 1px solid rgba(255,255,255,0.08);
            }

            .silly-name-tag {
                font-weight: 800;
                font-size: 16px;
            }
        `;

        // Gắn class theme vào body
        document.body.className = document.body.className.replace(/theme-\w+/g, '');
        document.body.classList.add(cfg.theme);
    }

    // ==========================================
    // 3. OBSERVER: BIẾN ĐỔI CHAT DOM THÀNH TAVERN
    // ==========================================
    function revampTurn(turnElement) {
        if (turnElement.getAttribute('data-silly-styled') === 'true') return;

        const cfg = getConfig();
        const isUser = turnElement.innerText.includes('User') || turnElement.classList.contains('user-turn') || turnElement.querySelector('[aria-label*="User"]');
        const roleName = isUser ? cfg.userName : cfg.modelName;
        const roleAvatar = isUser ? cfg.userAvatar : cfg.modelAvatar;

        // Tìm vùng header gốc của AI Studio để thay thế
        const origHeader = turnElement.querySelector('ms-chat-turn-header, .chat-turn-header, .header');
        
        // Tạo header kiểu Visual Novel mới
        const tavernHeader = document.createElement('div');
        tavernHeader.className = 'silly-header-row';
        tavernHeader.innerHTML = `
            <img class="silly-avatar-img" src="${roleAvatar}" alt="${roleName}">
            <span class="silly-name-tag">${roleName}</span>
        `;

        if (origHeader) {
            origHeader.style.display = 'none';
            origHeader.parentNode.insertBefore(tavernHeader, origHeader);
        } else {
            turnElement.insertBefore(tavernHeader, turnElement.firstChild);
        }

        turnElement.setAttribute('data-silly-styled', 'true');
    }

    const chatObserver = new MutationObserver((mutations) => {
        const turns = document.querySelectorAll('ms-chat-turn, .chat-turn');
        turns.forEach(revampTurn);
    });

    chatObserver.observe(document.documentElement, { childList: true, subtree: true });

    // ==========================================
    // 4. BẢNG CÀI ĐẶT SILLYSTUDIO (POPUP UI)
    // ==========================================
    window.addEventListener('DOMContentLoaded', () => {
        applyStylesAndThemes();

        // Nút mở Menu
        const fab = document.createElement('div');
        fab.id = 'silly-fab';
        fab.innerHTML = '🎭';
        fab.title = 'Tùy biến Visual Tavern (SillyStudio)';
        fab.style.cssText = `
            position: fixed; bottom: 205px; right: 25px; width: 50px; height: 50px;
            background: #1e1e2e; color: #f5c2e7; border: 2px solid #f5c2e7; border-radius: 50%;
            cursor: pointer; z-index: 999996; display: flex; align-items: center; justify-content: center;
            font-size: 24px; box-shadow: 0 4px 15px rgba(245, 194, 231, 0.4); transition: transform 0.2s;
        `;
        fab.onmouseenter = () => fab.style.transform = 'scale(1.1)';
        fab.onmouseleave = () => fab.style.transform = 'scale(1)';
        document.body.appendChild(fab);

        // Bảng Drawer Cài đặt
        const modal = document.createElement('div');
        modal.id = 'silly-modal';
        modal.style.cssText = `
            display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 500px; max-height: 85vh; background: #181825; color: #cdd6f4; border: 1px solid #45475a;
            border-radius: 12px; z-index: 1000000; box-shadow: 0 10px 40px rgba(0,0,0,0.8);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            flex-direction: column; overflow: hidden;
        `;

        modal.innerHTML = `
            <div style="padding:15px 20px; background:#11111b; border-bottom:1px solid #313244; display:flex; justify-content:space-between; align-items:center;">
                <span style="font-weight:bold; font-size:16px; color:#f5c2e7;">🎭 SILLYSTUDIO: TÙY BIẾN GIAO DIỆN</span>
                <span id="silly-close" style="cursor:pointer; font-size:22px; color:#f38ba8;">&times;</span>
            </div>
            <div style="padding:20px; overflow-y:auto; display:flex; flex-direction:column; gap:16px;">
                
                <!-- USER CONFIG -->
                <div style="background:#1e1e2e; padding:12px; border-radius:8px; border:1px solid #313244;">
                    <b style="color:#89b4fa; font-size:13px; display:block; margin-bottom:8px;">HỒ SƠ BẠN (USER):</b>
                    <input type="text" id="cfg-user-name" placeholder="Tên của bạn" style="width:95%; padding:6px; background:#313244; border:1px solid #45475a; color:#fff; border-radius:4px; margin-bottom:6px;">
                    <input type="text" id="cfg-user-avatar" placeholder="Link ảnh hoặc Link Google Drive" style="width:95%; padding:6px; background:#313244; border:1px solid #45475a; color:#fff; border-radius:4px;">
                    <div style="margin-top:6px; font-size:11px;">Hoặc tải ảnh từ máy: <input type="file" id="file-user-avatar" accept="image/*"></div>
                </div>

                <!-- MODEL CONFIG -->
                <div style="background:#1e1e2e; padding:12px; border-radius:8px; border:1px solid #313244;">
                    <b style="color:#f38ba8; font-size:13px; display:block; margin-bottom:8px;">HỒ SƠ NHÂN VẬT AI (MODEL):</b>
                    <input type="text" id="cfg-model-name" placeholder="Tên nhân vật / Bot" style="width:95%; padding:6px; background:#313244; border:1px solid #45475a; color:#fff; border-radius:4px; margin-bottom:6px;">
                    <input type="text" id="cfg-model-avatar" placeholder="Link ảnh hoặc Link Google Drive" style="width:95%; padding:6px; background:#313244; border:1px solid #45475a; color:#fff; border-radius:4px;">
                    <div style="margin-top:6px; font-size:11px;">Hoặc tải ảnh từ máy: <input type="file" id="file-model-avatar" accept="image/*"></div>
                </div>

                <!-- THEME & FONT -->
                <div style="background:#1e1e2e; padding:12px; border-radius:8px; border:1px solid #313244;">
                    <b style="color:#a6e3a1; font-size:13px; display:block; margin-bottom:8px;">PHONG CÁCH KHUNG CHAT & FONT CHỮ:</b>
                    <div style="display:flex; gap:10px; margin-bottom:8px;">
                        <select id="cfg-theme" style="flex:1; padding:6px; background:#313244; border:1px solid #45475a; color:#fff; border-radius:4px;">
                            <option value="theme-visualnovel">Visual Novel (Cổ điển)</option>
                            <option value="theme-fantasy">Fantasy Parchment (Giấy da cuộn)</option>
                            <option value="theme-cyberpunk">Cyberpunk Neon</option>
                            <option value="theme-gothic">Royal Gothic (Hoàng gia hắc ám)</option>
                            <option value="theme-terminal">Retro Green Terminal</option>
                        </select>
                        <select id="cfg-font" style="flex:1; padding:6px; background:#313244; border:1px solid #45475a; color:#fff; border-radius:4px;">
                            <option value="Playfair Display">Playfair Display (Lãng mạn/Tiểu thuyết)</option>
                            <option value="Cinzel">Cinzel (Hùng tráng/Fantasy)</option>
                            <option value="Dancing Script">Dancing Script (Viết tay bay bướm)</option>
                            <option value="VT323">VT323 (Cổ điển/Pixel 8-bit)</option>
                            <option value="Inter">Inter (Hiện đại, dễ đọc)</option>
                        </select>
                    </div>
                </div>

                <!-- WALLPAPER -->
                <div style="background:#1e1e2e; padding:12px; border-radius:8px; border:1px solid #313244;">
                    <b style="color:#f9e2af; font-size:13px; display:block; margin-bottom:8px;">ẢNH NỀN TOÀN TRANG (WALLPAPER):</b>
                    <input type="text" id="cfg-bg" placeholder="Dán URL ảnh nền bối cảnh..." style="width:95%; padding:6px; background:#313244; border:1px solid #45475a; color:#fff; border-radius:4px; margin-bottom:6px;">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span style="font-size:11px;">Độ mờ:</span>
                        <input type="range" id="cfg-bg-opacity" min="0.05" max="0.5" step="0.05" style="flex:1;">
                    </div>
                </div>
            </div>
            <div style="padding:12px 20px; background:#11111b; border-top:1px solid #313244; display:flex; justify-content:flex-end;">
                <button id="silly-save-btn" style="background:#f5c2e7; color:#11111b; border:none; padding:8px 20px; border-radius:6px; font-weight:bold; cursor:pointer;">Lưu Giao Diện</button>
            </div>
        `;
        document.body.appendChild(modal);

        // Đọc file tải lên thành Base64
        function setupFileReader(inputId, targetInputId) {
            document.getElementById(inputId).addEventListener('change', function () {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        document.getElementById(targetInputId).value = e.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });
        }
        setupFileReader('file-user-avatar', 'cfg-user-avatar');
        setupFileReader('file-model-avatar', 'cfg-model-avatar');

        // Toggle Modal
        fab.addEventListener('click', () => {
            const cfg = getConfig();
            document.getElementById('cfg-user-name').value = cfg.userName;
            document.getElementById('cfg-user-avatar').value = cfg.userAvatar;
            document.getElementById('cfg-model-name').value = cfg.modelName;
            document.getElementById('cfg-model-avatar').value = cfg.modelAvatar;
            document.getElementById('cfg-theme').value = cfg.theme;
            document.getElementById('cfg-font').value = cfg.fontFamily;
            document.getElementById('cfg-bg').value = cfg.bgImage;
            document.getElementById('cfg-bg-opacity').value = cfg.bgOpacity;

            modal.style.display = 'flex';
        });

        document.getElementById('silly-close').addEventListener('click', () => modal.style.display = 'none');

        // Lưu thiết lập
        document.getElementById('silly-save-btn').addEventListener('click', () => {
            const updated = {
                userName: document.getElementById('cfg-user-name').value.trim() || 'User',
                userAvatar: fixGoogleDriveUrl(document.getElementById('cfg-user-avatar').value.trim()),
                modelName: document.getElementById('cfg-model-name').value.trim() || 'Model',
                modelAvatar: fixGoogleDriveUrl(document.getElementById('cfg-model-avatar').value.trim()),
                theme: document.getElementById('cfg-theme').value,
                fontFamily: document.getElementById('cfg-font').value,
                bgImage: fixGoogleDriveUrl(document.getElementById('cfg-bg').value.trim()),
                bgOpacity: document.getElementById('cfg-bg-opacity').value
            };

            saveConfig(updated);
            modal.style.display = 'none';

            // Reset trạng thái trên DOM để render lại toàn bộ avatar và tên
            document.querySelectorAll('[data-silly-styled]').forEach(el => el.removeAttribute('data-silly-styled'));
            document.querySelectorAll('.silly-header-row').forEach(el => el.remove());
            document.querySelectorAll('ms-chat-turn, .chat-turn').forEach(revampTurn);
        });
    });

})();
